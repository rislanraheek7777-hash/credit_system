-- =============================================================================
-- pgTAP Integration Test: credential_recovery.tap
-- Stories 1.10/1.11 — Standalone credential recovery backend.
-- Proves the real PostgreSQL boundary: resolver narrowing, FORCE RLS on the
-- challenge table, shop-scoped contact uniqueness, atomic SQL rate limiting,
-- the reserved system audit actor, and the create/finalize/load/replay path
-- used by the standalone backend after a process restart.
-- =============================================================================

\set ON_ERROR_STOP on

BEGIN;

CREATE EXTENSION IF NOT EXISTS pgtap;

SELECT plan(27);

SAVEPOINT fixtures_start;

-- Transient helper lives inside the rolled-back transaction so repeated runs
-- in one pg_prove session cannot collide.
DROP TABLE IF EXISTS tap_recovery_operations;
CREATE TEMP TABLE tap_recovery_operations (
    client_operation_id uuid,
    idempotency_key uuid
);
CREATE TEMP TABLE tap_rate_limited (
    client_operation_id uuid,
    idempotency_key uuid
);

INSERT INTO public.shops (id, name, currency_code, timezone, created_at, updated_at)
VALUES
    ('aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa'::uuid, 'Recovery Tenant A', 'LKR', 'Asia/Colombo', NOW(), NOW()),
    ('bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb'::uuid, 'Recovery Tenant B', 'LKR', 'Asia/Colombo', NOW(), NOW());

INSERT INTO public.app_users (
    id, shop_id, username, email, phone, full_name, role,
    is_active, session_version, password_hash, created_at, updated_at
) VALUES
    ('a0000000-0000-0000-0000-000000000001'::uuid, 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa'::uuid,
     'user_a', 'user_a@example.com', '+947700000001', 'User A', 'cashier', TRUE, 1, 'hash', NOW(), NOW()),
    ('b0000000-0000-0000-0000-000000000001'::uuid, 'bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb'::uuid,
     'user_b', 'user_b@example.com', '+947700000002', 'User B', 'cashier', TRUE, 1, 'hash', NOW(), NOW());

-- -----------------------------------------------------------------------------
-- Schema contract
-- -----------------------------------------------------------------------------
SELECT has_table('public', 'credential_recovery_challenges',
    'T-CR-01: credential_recovery_challenges table exists');
SELECT has_column('public', 'credential_recovery_challenges', 'otp_hash',
    'T-CR-02: only the OTP digest column is persisted');
SELECT ok(
    (SELECT forcepolicies FROM pg_class
      WHERE relname = 'credential_recovery_challenges'
        AND relnamespace = 'public'::regnamespace),
    'T-CR-03: FORCE ROW LEVEL SECURITY is enabled on challenges');

SELECT throws_ok(
    $$ INSERT INTO public.app_users
        (id, shop_id, username, email, full_name, role, created_at, updated_at)
      VALUES
        ('a0000000-0000-0000-0000-000000000009'::uuid,
         'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa'::uuid,
         'dup_email', 'user_a@example.com', 'Duplicate', 'cashier', NOW(), NOW()) $$,
    '23505', NULL,
    'T-CR-04: duplicate email within one tenant is rejected');

-- -----------------------------------------------------------------------------
-- Narrow resolver under the unauthenticated runtime role
-- -----------------------------------------------------------------------------
SET LOCAL ROLE cs_app;

SELECT is(
    (SELECT count(*)::integer FROM public.cs_resolve_recovery_identity('user_a', 'email')),
    1,
    'T-CR-05: resolver finds exactly one enrolled account');

SELECT is(
    (SELECT match_count FROM public.cs_resolve_recovery_identity('user_a', 'email')),
    1,
    'T-CR-06: unambiguous match reports match_count = 1');

SELECT is(
    (SELECT shop_id FROM public.cs_resolve_recovery_identity('user_a', 'email')),
    'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa'::uuid,
    'T-CR-07: tenant context is derived from the server record');

SELECT is(
    (SELECT count(*)::integer FROM public.cs_resolve_recovery_identity('nobody', 'email')),
    0,
    'T-CR-08: unknown identifier returns no row');

SELECT is(
    (SELECT count(*)::integer FROM public.cs_resolve_recovery_identity('USER_A', 'email')),
    1,
    'T-CR-08b: mixed-case username resolves on the email channel');

RESET ROLE;

-- Ambiguous contact across tenants must report > 1 so the backend rejects it.
INSERT INTO public.app_users (
    id, shop_id, username, email, full_name, role,
    is_active, session_version, password_hash, created_at, updated_at
) VALUES (
    'b0000000-0000-0000-0000-000000000002'::uuid,
    'bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb'::uuid,
    'duplicate_a', 'user_a@example.com', 'Duplicate', 'cashier', TRUE, 1, 'hash', NOW(), NOW()
);

SET LOCAL ROLE cs_app;
SELECT is(
    (SELECT match_count FROM public.cs_resolve_recovery_identity('user_a', 'email')),
    2,
    'T-CR-09: ambiguous cross-tenant contact is flagged for Category 14 rejection');
RESET ROLE;

-- -----------------------------------------------------------------------------
-- Atomic rate limiting and system audit actor
-- -----------------------------------------------------------------------------
SET LOCAL app.current_shop_id = 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa';
SET LOCAL ROLE cs_app;

INSERT INTO tap_recovery_operations (client_operation_id, idempotency_key)
VALUES (gen_random_uuid(), gen_random_uuid());

SELECT is(
    (SELECT status FROM public.cs_create_recovery_challenge(
        'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa'::uuid,
        'a0000000-0000-0000-0000-000000000001'::uuid,
        'email', 'user_a@example.com',
        (SELECT client_operation_id FROM tap_recovery_operations),
        (SELECT idempotency_key FROM tap_recovery_operations))),
    'created',
    'T-CR-10: first challenge is created');

DO $fill$
DECLARE
    i integer;
BEGIN
    FOR i IN 1..4 LOOP
        PERFORM public.cs_create_recovery_challenge(
            'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa'::uuid,
            'a0000000-0000-0000-0000-000000000001'::uuid,
            'email', 'user_a@example.com', gen_random_uuid(), gen_random_uuid());
    END LOOP;
END;
$fill$;

INSERT INTO tap_rate_limited (client_operation_id, idempotency_key)
VALUES (gen_random_uuid(), gen_random_uuid());

SELECT is(
    (SELECT status FROM public.cs_create_recovery_challenge(
        'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa'::uuid,
        'a0000000-0000-0000-0000-000000000001'::uuid,
        'email', 'user_a@example.com',
        (SELECT client_operation_id FROM tap_rate_limited),
        (SELECT idempotency_key FROM tap_rate_limited))),
    'rate_limited',
    'T-CR-11: sixth request in the window is rejected atomically');

SELECT is(
    (SELECT count(*)::integer FROM public.credential_recovery_operations
      WHERE client_operation_id =
        (SELECT client_operation_id FROM tap_rate_limited)),
    0,
    'T-CR-11b: throttled requests create no ledger rows');

SELECT is(
    (SELECT count(*)::integer FROM public.audit_events
      WHERE shop_id = 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa'::uuid
        AND action_type = 'credential_recovery_requested'
        AND actor_id = (
            SELECT (
                substr(md5('aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa' || '|cs_recovery_system_actor'), 1, 8) || '-' ||
                substr(md5('aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa' || '|cs_recovery_system_actor'), 9, 4) || '-5' ||
                substr(md5('aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa' || '|cs_recovery_system_actor'), 13, 3) || '-8' ||
                substr(md5('aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa' || '|cs_recovery_system_actor'), 17, 3) || '-' ||
                substr(md5('aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa' || '|cs_recovery_system_actor'), 20, 12)
            )::uuid
        ),
     5,
    'T-CR-12: unauthenticated audits use the reserved system actor');

-- -----------------------------------------------------------------------------
-- Backend-owned finalize / restart-safe lookup / replay branch
-- -----------------------------------------------------------------------------
SELECT is(
    (SELECT count(*)::integer FROM public.cs_finalize_recovery_challenge(
        (SELECT client_operation_id FROM tap_recovery_operations),
        repeat(md5('backend-peppered-otp'), 2),
        repeat(md5('backend-reference-digest'), 2))),
    1,
    'T-CR-13: finalize installs the digest and returns the stored challenge');

SELECT is(
    (SELECT otp_hash FROM public.credential_recovery_challenges
      WHERE client_operation_id =
        (SELECT client_operation_id FROM tap_recovery_operations)),
    repeat(md5('backend-peppered-otp'), 2),
    'T-CR-14: only the peppered OTP digest is persisted');

SELECT is(
    (SELECT client_operation_id FROM public.cs_load_recovery_for_reference(
        (SELECT client_operation_id FROM tap_recovery_operations))),
    (SELECT client_operation_id FROM tap_recovery_operations),
    'T-CR-15: identifiers load from PostgreSQL alone after restart');

SELECT is(
    (SELECT status FROM public.cs_create_recovery_challenge(
        'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa'::uuid,
        'a0000000-0000-0000-0000-000000000001'::uuid,
        'email', 'user_a@example.com',
        (SELECT client_operation_id FROM tap_recovery_operations),
        (SELECT idempotency_key FROM tap_recovery_operations))),
    'existing',
    'T-CR-16: re-transmission returns the existing challenge');

SELECT is(
    (SELECT count(*)::integer FROM public.credential_recovery_challenges
      WHERE client_operation_id =
        (SELECT client_operation_id FROM tap_recovery_operations)),
    1,
    'T-CR-17: replay does not create a second challenge or second delivery');

SELECT is(
    pg_catalog.set_config(
        'app.current_shop_id', 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', true),
    'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa',
    'T-CR-18: tenant context uses set_config with a bound-parameter-compatible value');

SELECT is(
    (SELECT idempotency_key FROM public.cs_create_recovery_challenge(
        'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa'::uuid,
        'a0000000-0000-0000-0000-000000000001'::uuid,
        'email', 'user_a@example.com',
        (SELECT client_operation_id FROM tap_recovery_operations),
        gen_random_uuid())),
    (SELECT idempotency_key FROM tap_recovery_operations),
    'T-CR-20: replay with a different caller key returns the stored key');

SELECT is(
    (SELECT count(*)::integer FROM public.app_users
      WHERE shop_id = 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa'::uuid
        AND username = '__system_recovery_actor__' || 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa'::text
        AND NOT is_active
        AND password_hash IS NULL),
    1,
    'T-CR-22: audit actor uses a collision-safe tenant-scoped username');

-- Real-SQL proof of the backend's atomic rotation under tenant context.
UPDATE public.app_users
   SET password_hash = repeat(md5('backend-rotated-hash'), 2),
       session_version = session_version + 1,
       updated_at = NOW()
 WHERE id = 'a0000000-0000-0000-0000-000000000001'::uuid
   AND shop_id = 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa'::uuid;

SELECT is(
    (SELECT session_version FROM public.app_users
      WHERE id = 'a0000000-0000-0000-0000-000000000001'::uuid),
    2,
    'T-CR-23: SQL rotation increments session_version exactly once');

SELECT is(
    (SELECT password_hash FROM public.app_users
      WHERE id = 'a0000000-0000-0000-0000-000000000001'::uuid),
    repeat(md5('backend-rotated-hash'), 2),
    'T-CR-23b: SQL rotation replaces the password hash');

-- The exact backend predicate with a foreign tenant id must affect no row.
UPDATE public.app_users
   SET password_hash = repeat(md5('cross-tenant-write'), 2),
       session_version = session_version + 1
 WHERE id = 'a0000000-0000-0000-0000-000000000001'::uuid
   AND shop_id = 'bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb'::uuid;
SELECT is(
    (SELECT session_version FROM public.app_users
      WHERE id = 'a0000000-0000-0000-0000-000000000001'::uuid),
    2,
    'T-CR-24: cross-tenant rotation predicate cannot bump another tenant''s session');

-- The expiry-bound reference predicate is mandatory for verification.
UPDATE public.credential_recovery_challenges
   SET delivery_reference_hash = NULL
 WHERE client_operation_id =
   (SELECT client_operation_id FROM tap_recovery_operations);
SELECT is(
    (SELECT count(*)::integer FROM public.credential_recovery_challenges
      WHERE client_operation_id =
          (SELECT client_operation_id FROM tap_recovery_operations)
        AND delivery_reference_hash = repeat(md5('backend-reference-digest'), 2)),
    0,
    'T-CR-24b: removing the reference digest makes the challenge unverifiable');

SET LOCAL app.current_shop_id = 'bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb';
SELECT is(
    (SELECT count(*)::integer FROM public.credential_recovery_challenges
      WHERE shop_id = 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa'::uuid),
    0,
    'T-CR-19: FORCE RLS hides another tenant''s challenges from the backend role');

RESET ROLE;
ROLLBACK TO SAVEPOINT fixtures_start;
ROLLBACK;
