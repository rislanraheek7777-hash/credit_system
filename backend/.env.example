# Copy to .env and fill with real values. Never commit the populated file.
DATABASE_URL=postgres://cs_app:password@localhost:5432/credit_system
CS_RECOVERY_OTP_PEPPER=replace-with-a-long-random-server-secret
CS_RECOVERY_ABUSE_SHOP_ID=00000000-0000-4000-8000-000000000001

# Enable SMTP and/or SMS independently; at least one channel is required.
CS_RECOVERY_SMTP_HOST=smtp.example.internal
CS_RECOVERY_SMTP_PORT=465
CS_RECOVERY_SMTP_USER=
CS_RECOVERY_SMTP_PASSWORD=
CS_RECOVERY_EMAIL_FROM=noreply@example.internal
CS_RECOVERY_SMTP_TLS=true
CS_RECOVERY_SMTP_HELO=localhost

CS_RECOVERY_SMS_ENDPOINT=https://sms.example.internal/send
CS_RECOVERY_SMS_SENDER=CreditSystem
CS_RECOVERY_SMS_API_KEY=

CS_RECOVERY_SERVER_HOST=127.0.0.1
CS_RECOVERY_SERVER_PORT=8081
# Required when CS_RECOVERY_SERVER_HOST is not loopback:
# CS_RECOVERY_TLS_CERT_PATH=/etc/tls/recovery.crt
# CS_RECOVERY_TLS_KEY_PATH=/etc/tls/recovery.key

CS_RECOVERY_MIGRATION_SQL_PATH=../lib/core/data/remote/migrations/003_credential_recovery.sql
